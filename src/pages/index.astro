                <div class="bento-card bento-small">
                    <div class="bento-bg">
                        <img src="files/artist_workspace_3_1787349880257.jpg" alt="Design de Moda e Croquis" />
                        <div class="bento-overlay"></div>
                    </div>
                    <div class="bento-content">
                        <div class="bento-tag">Design</div>
                        <h3 class="bento-name">Croquis Dinâmicos</h3>
                        <p class="bento-desc">Fluxo de tinta constante e imediato para capturar ideias expressivas na velocidade do pensamento criativo.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <Marquee />
    <VideoStrip />
    <SpecsTable />
    <Footer />

    <!-- ========================================
         JAVASCRIPT
    ========================================= -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const loader = document.getElementById('loader');
            const nav = document.getElementById('mainNav');
            const heroTitle = document.getElementById('heroTitle');
            const scrollVideo = document.getElementById('scrollVideo');
            const scrollProgress = document.getElementById('scrollProgress');

            // ----------------------------------------
            // 1. Loader & Initial Animations
            // ----------------------------------------
            window.addEventListener('load', () => {
                // Hide loader
                setTimeout(() => {
                    loader.classList.add('hidden');
                }, 600);

                // Nav entrance
                setTimeout(() => {
                    nav.classList.add('loaded');
                }, 800);

                // Hero title text reveal
                setTimeout(() => {
                    heroTitle.classList.add('reveal-active');
                }, 1000);

                // Trigger all hero reveal elements
                setTimeout(() => {
                    document.querySelectorAll('.hero .reveal').forEach(el => {
                        el.classList.add('active');
                    });
                }, 1200);
            });

            // ----------------------------------------
            // 2. Intersection Observer for Reveals
            //    (from Design System pattern)
            // ----------------------------------------
            const observerOptions = {
                root: null,
                rootMargin: '0px',
                threshold: 0.15,
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('active');

                        // Trigger stat counter animation
                        const counter = entry.target.querySelector('.stat-number[data-count]');
                        if (counter && !counter.dataset.animated) {
                            counter.dataset.animated = 'true';
                            animateCounter(counter);
                        }
                    }
                });
            }, observerOptions);

            document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

            // ----------------------------------------
            // Counter Animation for Stats
            // ----------------------------------------
            function animateCounter(el) {
                const target = parseFloat(el.dataset.count);
                const suffix = el.dataset.suffix || '';
                const isDecimal = el.dataset.decimal === 'true';
                const duration = 2000;
                const startTime = performance.now();

                function easeOutExpo(t) {
                    return t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
                }

                function update(currentTime) {
                    const elapsed = currentTime - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    const easedProgress = easeOutExpo(progress);
                    const current = target * easedProgress;

                    if (isDecimal) {
                        el.textContent = current.toFixed(2) + suffix;
                    } else {
                        el.textContent = Math.round(current).toLocaleString('pt-BR') + suffix;
                    }

                    if (progress < 1) {
                        requestAnimationFrame(update);
                    }
                }

                requestAnimationFrame(update);
            }

            // ----------------------------------------
            // Floating Icons Parallax (benefits section)
            // ----------------------------------------
            const floatingIcons = document.querySelectorAll('.floating-icon');
            if (floatingIcons.length > 0) {
                window.addEventListener('scroll', () => {
                    const benefitsSection = document.getElementById('benefits');
                    if (!benefitsSection) return;
                    const rect = benefitsSection.getBoundingClientRect();
                    const inView = rect.top < window.innerHeight && rect.bottom > 0;
                    if (inView) {
                        const progress = (window.innerHeight - rect.top) / (window.innerHeight + rect.height);
                        floatingIcons.forEach((icon, i) => {
                            const speed = (i + 1) * 8;
                            const y = (progress - 0.5) * speed;
                            icon.style.transform = `translateY(${y}px)`;
                        });
                    }
                });
            }

            // ----------------------------------------
            // GSAP Animations for Benefits Section
            // ----------------------------------------
            if (typeof gsap !== 'undefined') {
                // Staggered entrance for benefit cards
                gsap.utils.toArray('.benefit-card').forEach((card, i) => {
                    gsap.from(card, {
                        scrollTrigger: {
                            trigger: card,
                            start: 'top 85%',
                            toggleActions: 'play none none none',
                        },
                        opacity: 0,
                        x: 40,
                        duration: 0.9,
                        delay: i * 0.15,
                        ease: 'power3.out',
                    });
                });

                // Product image scale entrance
                gsap.from('#benefitsVisual img', {
                    scrollTrigger: {
                        trigger: '#benefitsVisual',
                        start: 'top 80%',
                        toggleActions: 'play none none none',
                    },
                    scale: 0.85,
                    opacity: 0,
                    duration: 1.4,
                    ease: 'power3.out',
                });

                // Floating icons stagger
                gsap.from('.floating-icon', {
                    scrollTrigger: {
                        trigger: '#benefitsVisual',
                        start: 'top 75%',
                        toggleActions: 'play none none none',
                    },
                    scale: 0,
                    opacity: 0,
                    duration: 0.6,
                    stagger: 0.15,
                    ease: 'back.out(1.7)',
                });

                // Connection dots pulse in
                gsap.from('.connection-dot', {
                    scrollTrigger: {
                        trigger: '#benefitsVisual',
                        start: 'top 70%',
                        toggleActions: 'play none none none',
                    },
                    scale: 0,
                    duration: 0.4,
                    stagger: 0.1,
                    ease: 'power2.out',
                });
            }

            // ----------------------------------------
            // 3. Scroll Progress Bar
            // ----------------------------------------
            window.addEventListener('scroll', () => {
                const scrollTop = window.scrollY;
                const docHeight = document.documentElement.scrollHeight - window.innerHeight;
                const scrollPercent = (scrollTop / docHeight) * 100;
                scrollProgress.style.width = scrollPercent + '%';
            });

            // ----------------------------------------
            // 4. GSAP ScrollTrigger — Video Scrubbing
            //    (Apple-style scroll-driven animation)
            // ----------------------------------------
            gsap.registerPlugin(ScrollTrigger);

            // Wait for video metadata to load
            scrollVideo.addEventListener('loadedmetadata', () => {
                const videoDuration = scrollVideo.duration;

                // Smoothly interpolate currentTime with rAF
                let targetTime = 0;
                let currentAnimTime = 0;

                function updateVideoTime() {
                    // Lerp for buttery smooth playback - increased multiplier for agility
                    currentAnimTime += (targetTime - currentAnimTime) * 0.35;
                    if (Math.abs(currentAnimTime - targetTime) > 0.01) {
                        scrollVideo.currentTime = currentAnimTime;
                    }
                    requestAnimationFrame(updateVideoTime);
                }
                requestAnimationFrame(updateVideoTime);

                // ScrollTrigger to scrub video
                ScrollTrigger.create({
                    trigger: '#video',
                    start: 'top top',
                    end: 'bottom bottom',
                    scrub: 0.1, // Small scrub delay instead of true for a bit more agility
                    onUpdate: (self) => {
                        targetTime = self.progress * videoDuration;
                    },
                });

                // Animate overlay text in at ~40% scroll progress
                gsap.to('#videoText', {
                    opacity: 1,
                    y: 0,
                    scale: 1.05,
                    duration: 1,
                    ease: 'power3.out',
                    scrollTrigger: {
                        trigger: '#video',
                        start: '30% top',
                        end: '50% top',
                        scrub: true,
                    },
                });

                gsap.to('#videoSub', {
                    opacity: 1,
                    y: 0,
                    duration: 1,
                    ease: 'power3.out',
                    scrollTrigger: {
                        trigger: '#video',
                        start: '35% top',
                        end: '55% top',
                        scrub: true,
                    },
                });

                // Fade out overlay text near the end
                gsap.to(['#videoText', '#videoSub'], {
                    opacity: 0,
                    y: -30,
                    scrollTrigger: {
                        trigger: '#video',
                        start: '70% top',
                        end: '85% top',
                        scrub: true,
                    },
                });
            });

            // ----------------------------------------
            // 5. Smooth Scroll for Explore Button
            // ----------------------------------------
            const btnExplore = document.getElementById('btnExplore');
            if (btnExplore) {
                btnExplore.addEventListener('click', () => {
                    document.getElementById('video').scrollIntoView({
                        behavior: 'smooth',
                    });
                });
            }

            // ----------------------------------------
            // 6. Play Button — Scroll to Video
            // ----------------------------------------
            const heroPlayBtn = document.getElementById('heroPlayBtn');
            if (heroPlayBtn) {
                heroPlayBtn.addEventListener('click', () => {
                    document.getElementById('video').scrollIntoView({
                        behavior: 'smooth',
                    });
                });
            }

            // ----------------------------------------
            // 7. Use Cases (Bento Grid) Animations
            // ----------------------------------------
            if (typeof gsap !== 'undefined') {
                gsap.from('.bento-card', {
                    scrollTrigger: {
                        trigger: '.bento-grid',
                        start: 'top 85%',
                        toggleActions: 'play none none none',
                    },
                    y: 60,
                    opacity: 0,
                    duration: 1,
                    stagger: 0.15,
                    ease: 'power3.out',
                });
            }

        });
    </script>

</body>
</html>
