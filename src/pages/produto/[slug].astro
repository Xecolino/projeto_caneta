const { product } = Astro.props;
---

    <style is:global>
        :root {
            --bg-main: #FFFFFF;
            --bg-surface: #F5F5F4;
            --bg-subtle: #FAFAFA;
            --text-primary: #1C1C1C;
            --text-secondary: #57534E;
            --text-muted: #A8A29E;
            --text-faint: #D6D3D1;
            --border-light: #E7E5E4;
            --border-medium: #D6D3D1;
            --primary-dark: #1C1917;
            --accent-warm: #E8927C;

            --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            --easing-smooth: cubic-bezier(0.16, 1, 0.3, 1);
            
            --radius-sm: 0.375rem;
            --radius-md: 0.75rem;
            --radius-lg: 1rem;
            --radius-xl: 1.5rem;
            --radius-full: 9999px;
        }

        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            font-size: 16px;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body {
            font-family: var(--font-sans);
            background-color: var(--bg-main);
            color: var(--text-primary);
            overflow-x: hidden;
            line-height: 1.6;
        }

        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.7' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
            opacity: 0.025;
            pointer-events: none;
            z-index: 9999;
        }
        
        /* Product Page Layout */
        .product-page {
            padding: 140px 2rem 8rem;
            max-width: 1400px;
            margin: 0 auto;
            width: 100%;
            min-height: calc(100vh - 120px);
        }

        .product-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            align-items: start;
        }

        .product-image-section {
            position: sticky;
            top: 120px;
            border-radius: var(--radius-xl);
            overflow: hidden;
            background: #000;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        }

        .main-image {
            width: 100%;
            height: auto;
            display: block;
            aspect-ratio: 4/3;
            object-fit: cover;
        }

        .product-info-section {
            padding: 2rem 0;
            display: flex;
            flex-direction: column;
        }

        .badge {
            display: inline-block;
            padding: 0.25rem 1rem;
            background: var(--bg-surface);
            border: 1px solid var(--border-medium);
            border-radius: var(--radius-full);
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--text-secondary);
            margin-bottom: 1.5rem;
            align-self: flex-start;
        }

        .product-title {
            font-size: clamp(2.5rem, 4vw, 3.5rem);
            font-weight: 600;
            letter-spacing: -0.03em;
            color: var(--text-primary);
            line-height: 1.1;
            margin-bottom: 1rem;
        }

        .product-price {
            font-size: 1.5rem;
            font-weight: 500;
            color: var(--text-secondary);
            margin-bottom: 2.5rem;
        }

        .product-description {
            font-size: 1.125rem;
            color: var(--text-secondary);
            line-height: 1.7;
            margin-bottom: 3rem;
            max-width: 90%;
        }

        .product-specs {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1.5rem;
            margin-bottom: 4rem;
            border-top: 1px solid var(--border-light);
            padding-top: 2.5rem;
        }

        .spec-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-light);
            padding-bottom: 1rem;
        }

        .spec-label {
            font-size: 0.875rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .spec-value {
            font-size: 1.125rem;
            font-weight: 500;
            color: var(--text-primary);
        }

        .product-actions {
            margin-top: auto;
        }

        .full-width-btn {
            width: 100%;
            padding: 1.25rem;
            font-size: 1rem;
            font-weight: 600;
        }

        @media (max-width: 1024px) {
            .product-container {
                grid-template-columns: 1fr;
                gap: 3rem;
            }
            .product-image-section {
                position: relative;
                top: 0;
            }
            .product-description {
                max-width: 100%;
            }
        }
    </style>

<Layout
    title={`${product.title} — Avise-me Quando Disponível | ARTOOLS`}
    description={`Garanta prioridade para adquirir o modelo ${product.title}. Cadastre-se na lista de espera exclusiva e receba nosso aviso de estoque ('Avise-me') assim que o produto estiver disponível.`}
    image={product.imgSrc}
>
    <Header />
    
    <main class="product-page" transition:animate="slide">
        <div class="product-container">
            <!-- Coluna da Imagem -->
            <div class="product-image-section">
                <img src={product.imgSrc} alt={product.title} class="main-image" />
            </div>
            
            <!-- Coluna de Informações -->
            <div class="product-info-section">
                <div class="badge">{product.badge}</div>
                <h1 class="product-title">{product.title}</h1>
                <p class="product-price">{product.price}</p>
                
                <p class="product-description">
                    {product.description}
                </p>

                <h2 class="sr-only">Especificações Técnicas</h2>
                <div class="product-specs">
                    {product.specs.map(spec => (
                        <div class="spec-item">
                            <span class="spec-label">{spec.label}</span>
                            <span class="spec-value">{spec.value}</span>
                        </div>
                    ))}
                </div>

                <div class="product-actions">
                    <Button variant="primary" class="full-width-btn" id="notify-btn">
                        <span>Avise-me quando disponível</span>
                    </Button>
                </div>
            </div>
        </div>
    </main>

    <Footer />

    <StockModal productTitle={product.title} />

    <script is:inline>
        document.addEventListener('astro:page-load', () => {
            const nav = document.getElementById('mainNav');
            if (nav) nav.classList.add('loaded');
        });
    </script>
</Layout>
