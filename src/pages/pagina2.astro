---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
---

<Layout
    title="Coleção Completa ARTOOLS — Catálogo de Canetas de Alta Precisão"
    description="Conheça a coleção completa da ArtTools. Explore todos os nossos modelos exclusivos de canetas de alta precisão, materiais nobres e mecânica suíça."
    image="/pens/pen_carbon_1787826166186.jpg"
>
    <Header />
    
    <main class="catalog-page" transition:animate="slide">
        <section class="catalog-header">
            <h1 class="catalog-title">Catálogo de Produtos</h1>
            <p class="catalog-subtitle">Descubra a precisão em cada um de nossos modelos exclusivos. Explore as diferentes configurações e encontre a ferramenta ideal para a sua criatividade.</p>
        </section>
        
        <section class="catalog-grid">
            <ProductCard 
                title="Precision Pen Classic" 
                description="O equilíbrio perfeito entre design atemporal e mecânica de alta precisão." 
                imgSrc="/pens/pen_classic_1787826098842.jpg"
                slug="classic"
            />
            <ProductCard 
                title="Precision Pen Obsidian" 
                description="Edição limitada com acabamento em preto fosco profundo e detalhes em titânio negro." 
                imgSrc="/pens/pen_obsidian_1787826110110.jpg"
                slug="obsidian"
            />
            <ProductCard 
                title="Precision Pen Aerospacial" 
                description="Usinada a partir de liga de alumínio 7075 aeronáutico. Leveza e durabilidade incomparáveis." 
                imgSrc="/pens/pen_aerospacial_1787826122502.jpg"
                slug="aerospacial"
            />
            <ProductCard 
                title="Precision Pen Minimal" 
                description="Linhas puras, sem adornos desnecessários. Foco absoluto na ergonomia e na fluidez do traço." 
                imgSrc="/pens/pen_minimal_1787826133464.jpg"
                slug="minimal"
            />
            <ProductCard 
                title="Precision Pen Studio" 
                description="Desenvolvida especificamente para arquitetos e designers. Empunhadura texturizada antiderrapante." 
                imgSrc="/pens/pen_studio_1787826144888.jpg"
                slug="studio"
            />
            <ProductCard 
                title="Precision Pen Rose Gold" 
                description="Banhada em ouro rosa 18k com detalhes em aço polido. Elegância refinada para qualquer ambiente." 
                imgSrc="/pens/pen_rosegold_1787826154885.jpg"
                slug="rose-gold"
            />
            <ProductCard 
                title="Precision Pen Carbon" 
                description="Construída com fibra de carbono autêntica. Estética futurista e durabilidade inigualável no uso urbano." 
                imgSrc="/pens/pen_carbon_1787826166186.jpg"
                slug="carbon"
            />
            <ProductCard 
                title="Precision Pen Ceramic" 
                description="Revestimento cerâmico de alta resistência contra arranhões, mantendo a aparência impecável por anos." 
                imgSrc="/pens/pen_ceramic_1787826177035.jpg"
                slug="ceramic"
            />
            <ProductCard 
                title="Precision Pen Heritage" 
                description="Inspirada nos grandes clássicos, une o passado romântico da escrita ao futuro da engenharia suíça." 
                imgSrc="/pens/pen_heritage_1787826188287.jpg"
                slug="heritage"
            />
        </section>
    </main>

    <Footer />

    <script is:inline>
        document.addEventListener('astro:page-load', () => {
            const nav = document.getElementById('mainNav');
            if (nav) nav.classList.add('loaded');
        });
    </script>
</Layout>

<style is:global>
    :root {
        --bg-main: #FFFFFF;
        --bg-surface: #F5F5F4;
        --bg-subtle: #FAFAFA;
        --text-primary: #1C1C1C;
        --text-secondary: #57534E;
        --text-muted: #A8A29E;
        --text-faint: #D6D3D1;
        --border-light: #E7E5E4;
        --border-medium: #D6D3D1;
        --primary-dark: #1C1917;
        --accent-warm: #E8927C;

        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --easing-smooth: cubic-bezier(0.16, 1, 0.3, 1);
        --easing-out: cubic-bezier(0.33, 1, 0.68, 1);

        --radius-sm: 0.375rem;
        --radius-md: 0.75rem;
        --radius-lg: 1rem;
        --radius-xl: 1.5rem;
        --radius-full: 9999px;
    }

    *, *::before, *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html {
        font-size: 16px;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    body {
        font-family: var(--font-sans);
        background-color: var(--bg-main);
        color: var(--text-primary);
        overflow-x: hidden;
        scrollbar-width: none;
        line-height: 1.6;
    }

    body::before {
        content: "";
        position: fixed;
        top: 0; left: 0; width: 100vw; height: 100vh;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.7' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        opacity: 0.025;
        pointer-events: none;
        z-index: 9999;
    }
    
    .catalog-page {
        padding: 90px 2rem 6rem;
        max-width: 1280px;
        margin: 0 auto;
        width: 100%;
        min-height: calc(100vh - 90px);
    }

    .catalog-header {
        text-align: left;
        margin-bottom: 2rem;
        padding: 1.5rem 0 1rem;
        position: relative;
        z-index: 1;
        border-bottom: 1px solid var(--border-light);
    }

    .catalog-title {
        font-size: clamp(1.75rem, 3vw, 2.5rem);
        font-weight: 600;
        color: var(--text-primary);
        letter-spacing: -0.02em;
        margin-bottom: 0.5rem;
    }

    .catalog-subtitle {
        font-size: 0.95rem;
        color: var(--text-secondary);
        max-width: 800px;
        line-height: 1.5;
    }

    .catalog-grid {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 2rem;
    }

    @media (max-width: 768px) {
        .catalog-page {
            padding: 85px 1.25rem 4rem;
        }

        .catalog-header {
            position: relative;
            top: auto;
            z-index: 1;
            padding: 0.5rem 0 1rem;
            margin-bottom: 1.5rem;
        }

        .catalog-grid {
            position: relative;
            z-index: 10;
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }
    }
</style>
