---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
---
<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Nova Página — ARTOOLS</title>

    <!-- Google Fonts — Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap" rel="stylesheet" />

    <!-- Iconify for icons -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/iconify-icon@2.1.0/dist/iconify-icon.min.js"></script>

    <style is:global>
        :root {
            --bg-main: #FFFFFF;
            --bg-surface: #F5F5F4;
            --bg-subtle: #FAFAFA;
            --text-primary: #1C1C1C;
            --text-secondary: #57534E;
            --text-muted: #A8A29E;
            --text-faint: #D6D3D1;
            --border-light: #E7E5E4;
            --border-medium: #D6D3D1;
            --primary-dark: #1C1917;
            --accent-warm: #E8927C;

            --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            --easing-smooth: cubic-bezier(0.16, 1, 0.3, 1);
            --easing-out: cubic-bezier(0.33, 1, 0.68, 1);

            --radius-sm: 0.375rem;
            --radius-md: 0.75rem;
            --radius-lg: 1rem;
            --radius-xl: 1.5rem;
            --radius-full: 9999px;
        }

        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            font-size: 16px;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body {
            font-family: var(--font-sans);
            background-color: var(--bg-main);
            color: var(--text-primary);
            overflow-x: hidden;
            scrollbar-width: none;
            line-height: 1.6;
        }

        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0; width: 100vw; height: 100vh;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.7' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
            opacity: 0.025;
            pointer-events: none;
            z-index: 9999;
        }
        
        .catalog-page {
            padding: 90px 2rem 6rem;
            max-width: 1280px;
            margin: 0 auto;
            width: 100%;
            min-height: calc(100vh - 90px);
        }

        .catalog-header {
            text-align: left;
            margin-bottom: 2rem;
            padding: 1rem 0;
            position: sticky;
            top: 70px; /* Logo nav is ~70px tall */
            z-index: 900;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-light);
        }

        .catalog-title {
            font-size: clamp(1.75rem, 3vw, 2.5rem);
            font-weight: 600;
            color: var(--text-primary);
            letter-spacing: -0.02em;
            margin-bottom: 0.5rem;
        }

        .catalog-subtitle {
            font-size: 0.95rem;
            color: var(--text-secondary);
            max-width: 800px;
            line-height: 1.5;
        }

        .catalog-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
            gap: 2rem;
        }
    </style>
</head>
<body>
    <Header />
    
    <main class="catalog-page">
        <section class="catalog-header">
            <h1 class="catalog-title">Catálogo de Produtos</h1>
            <p class="catalog-subtitle">Descubra a precisão em cada um de nossos modelos exclusivos. Explore as diferentes configurações e encontre a ferramenta ideal para a sua criatividade.</p>
        </section>
        
        <section class="catalog-grid">
            <ProductCard 
                title="Precision Pen Classic" 
                description="O equilíbrio perfeito entre design atemporal e mecânica de alta precisão." 
                imgSrc="/pens/pen_classic_1787826098842.jpg"
                slug="classic"
            />
            <ProductCard 
                title="Precision Pen Obsidian" 
                description="Edição limitada com acabamento em preto fosco profundo e detalhes em titânio negro." 
                imgSrc="/pens/pen_obsidian_1787826110110.jpg"
                slug="obsidian"
            />
            <ProductCard 
                title="Precision Pen Aerospacial" 
                description="Corpo em alumínio 7075-T6, garantindo resistência extrema e leveza absoluta para uso diário." 
                imgSrc="/pens/pen_aerospace_1787826121150.jpg"
                slug="aerospacial"
            />
            <ProductCard 
                title="Precision Pen Rose Gold" 
                description="Sofisticação em cada traço com corpo metálico escovado e estrutura banhada a ouro rosa 18k." 
                imgSrc="/pens/pen_rose_gold_1787826132162.jpg"
                slug="rose-gold"
            />
            <ProductCard 
                title="Precision Pen Executive" 
                description="Desenhada para o mundo corporativo, com peso balanceado para assinaturas firmes e confortáveis." 
                imgSrc="/pens/pen_executive_1787826143191.jpg"
                slug="executive"
            />
            <ProductCard 
                title="Precision Pen Sketch" 
                description="A escolha ideal para arquitetos e ilustradores, com ponta ultrafina focada no controle de traços precisos." 
                imgSrc="/pens/pen_sketch_1787826154652.jpg"
                slug="sketch"
            />
            <ProductCard 
                title="Precision Pen Carbon" 
                description="Construída com fibra de carbono autêntica. Estética futurista e durabilidade inigualável no uso urbano." 
                imgSrc="/pens/pen_carbon_1787826166186.jpg"
                slug="carbon"
            />
            <ProductCard 
                title="Precision Pen Ceramic" 
                description="Revestimento cerâmico de alta resistência contra arranhões, mantendo a aparência impecável por anos." 
                imgSrc="/pens/pen_ceramic_1787826177035.jpg"
                slug="ceramic"
            />
            <ProductCard 
                title="Precision Pen Heritage" 
                description="Inspirada nos grandes clássicos, une o passado romântico da escrita ao futuro da engenharia suíça." 
                imgSrc="/pens/pen_heritage_1787826188287.jpg"
                slug="heritage"
            />
        </section>
    </main>

    <Footer />

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            // Garante que o Header (navbar) apareça sem precisar dos carregadores complexos da index
            const nav = document.getElementById('mainNav');
            if (nav) nav.classList.add('loaded');
        });
    </script>
</body>
</html>
