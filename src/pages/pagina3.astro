---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import StockModal from '../components/StockModal.astro';

const product = {
  slug: 'classic',
  title: 'Precision Pen Classic',
  description: 'O equilíbrio perfeito entre design atemporal e mecânica de alta precisão. Projetada para acompanhar os pensamentos mais ágeis, esta caneta é forjada para durar gerações. Cada detalhe foi meticulosamente esculpido para proporcionar a escrita mais fluida do mundo.',
  price: 'R$ 1.000,00',
  badge: 'Edição Clássica',
  imgSrc: '/pens/pen_classic_1787826098842.jpg',
  specs: [
    { label: 'Material', value: 'Alumínio Aeroespacial' },
    { label: 'Mecanismo', value: 'Precisão Suíça' },
    { label: 'Ponta', value: '0.1mm Titânio' },
    { label: 'Peso', value: '12g' }
  ]
};
---

<style is:global>
    :root {
        --bg-main: #FFFFFF;
        --bg-surface: #F5F5F4;
        --bg-subtle: #FAFAFA;
        --text-primary: #1C1C1C;
        --text-secondary: #57534E;
        --text-muted: #A8A29E;
        --text-faint: #D6D3D1;
        --border-light: #E7E5E4;
        --border-medium: #D6D3D1;
        --primary-dark: #1C1917;
        --accent-warm: #E8927C;

        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --easing-smooth: cubic-bezier(0.16, 1, 0.3, 1);
        
        --radius-sm: 0.375rem;
        --radius-md: 0.75rem;
        --radius-lg: 1rem;
        --radius-xl: 1.5rem;
        --radius-full: 9999px;
    }

    *, *::before, *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html {
        font-size: 16px;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    body {
        font-family: var(--font-sans);
        background-color: var(--bg-main);
        color: var(--text-primary);
        overflow-x: hidden;
        line-height: 1.6;
    }

    body::before {
        content: "";
        position: fixed;
        top: 0; left: 0; width: 100vw; height: 100vh;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.7' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        opacity: 0.025;
        pointer-events: none;
        z-index: 9999;
    }

    /* Product Page Layout */
    .product-page {
        padding-top: 100px;
        padding-bottom: 6rem;
        min-height: 100vh;
    }

    .product-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 5rem;
        align-items: start;
    }

    .product-image-section {
        position: sticky;
        top: 120px;
        background: var(--bg-subtle);
        border-radius: var(--radius-xl);
        border: 1px solid var(--border-light);
        overflow: hidden;
        aspect-ratio: 4/3;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .main-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .product-info-section {
        display: flex;
        flex-direction: column;
    }

    .badge {
        align-self: flex-start;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        background: var(--bg-surface);
        color: var(--text-secondary);
        padding: 0.35rem 0.85rem;
        border-radius: var(--radius-full);
        border: 1px solid var(--border-medium);
        margin-bottom: 1.5rem;
    }

    .product-title {
        font-size: 3rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--text-primary);
        line-height: 1.1;
        margin-bottom: 1rem;
    }

    .product-price {
        font-size: 1.5rem;
        font-weight: 500;
        color: var(--text-secondary);
        margin-bottom: 2rem;
    }

    .product-description {
        font-size: 1.125rem;
        color: var(--text-secondary);
        line-height: 1.7;
        margin-bottom: 2.5rem;
        max-width: 90%;
    }

    .product-specs {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
        margin-bottom: 3rem;
        border-top: 1px solid var(--border-light);
        padding-top: 2rem;
    }

    .spec-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--border-light);
    }

    .spec-label {
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
    }

    .spec-value {
        font-size: 1rem;
        color: var(--text-primary);
        font-weight: 500;
    }

    .product-actions {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .full-width-btn {
        width: 100%;
        padding: 1.25rem 2rem !important;
        font-size: 1rem !important;
        font-weight: 600;
    }

    @media (max-width: 1024px) {
        .product-container {
            grid-template-columns: 1fr;
            gap: 3rem;
        }
        .product-image-section {
            position: relative;
            top: 0;
        }
        .product-description {
            max-width: 100%;
        }
    }
</style>

<Layout
    title={`${product.title} — Avise-me Quando Disponível | ARTOOLS`}
    description={`Garanta prioridade para adquirir o modelo ${product.title}. Cadastre-se na lista de espera exclusiva e receba nosso aviso de estoque ('Avise-me') assim que o produto estiver disponível.`}
    image={product.imgSrc}
>
    <Header />
    
    <main class="product-page" transition:animate="slide">
        <div class="product-container">
            <!-- Coluna da Imagem -->
            <div class="product-image-section">
                <img src={product.imgSrc} alt={product.title} class="main-image" />
            </div>
            
            <!-- Coluna de Informações -->
            <div class="product-info-section">
                <div class="badge">{product.badge}</div>
                <h1 class="product-title">{product.title}</h1>
                <p class="product-price">{product.price}</p>
                
                <p class="product-description">
                    {product.description}
                </p>

                <div class="product-specs">
                    {product.specs.map(spec => (
                        <div class="spec-item">
                            <span class="spec-label">{spec.label}</span>
                            <span class="spec-value">{spec.value}</span>
                        </div>
                    ))}
                </div>

                <div class="product-actions">
                    <Button variant="primary" class="full-width-btn" id="notify-btn">
                        <span>Avise-me quando disponível</span>
                    </Button>
                </div>
            </div>
        </div>
    </main>

    <Footer />

    <StockModal productTitle={product.title} />

    <script is:inline>
        document.addEventListener('astro:page-load', () => {
            const nav = document.getElementById('mainNav');
            if (nav) nav.classList.add('loaded');
        });
    </script>
</Layout>
