---
// src/components/ProductCard.astro
import Button from './Button.astro';

interface Props {
  title: string;
  description: string;
  imgSrc: string;
  imgAlt?: string;
  slug: string;
}

const { title, description, imgSrc, imgAlt = title, slug } = Astro.props;
---

<div class="product-card">
    <div class="product-image-wrapper">
        <img src={imgSrc} alt={imgAlt} class="product-image" loading="lazy" />
    </div>
    <div class="product-content">
        <h3 class="product-title">{title}</h3>
        <p class="product-desc">{description}</p>
        <Button variant="secondary" class="notify-btn" href={`/produto/${slug}`}>
            <span>Avise-me</span>
        </Button>
    </div>
</div>

<style>
    .product-card {
        background: var(--bg-surface, #F5F5F4);
        border: 1px solid var(--border-light, #E7E5E4);
        border-radius: var(--radius-lg, 1rem);
        padding: 0;
        transition: transform 0.4s var(--easing-smooth, ease), box-shadow 0.4s ease;
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
        min-width: 0; /* Prevents grid blowout */
    }
    
    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg, 0 10px 40px rgba(0, 0, 0, 0.08));
        background: var(--bg-main, #FFFFFF);
    }

    .product-image-wrapper {
        width: 100%;
        position: relative;
        aspect-ratio: 4/3;
        overflow: hidden;
        background: #000;
        flex-shrink: 0;
    }

    .product-image {
        width: 100%;
        height: 100%;
        max-width: 100%;
        display: block;
        object-fit: cover;
        transition: transform 0.7s var(--easing-smooth, ease);
    }

    .product-card:hover .product-image {
        transform: scale(1.05);
    }

    .product-content {
        display: flex;
        flex-direction: column;
        padding: 2rem;
        height: 100%;
    }

    .product-title {
        font-size: 1.5rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        margin-bottom: 1rem;
        color: var(--text-primary, #1C1C1C);
    }

    .product-desc {
        font-size: 1rem;
        color: var(--text-secondary, #57534E);
        line-height: 1.6;
        margin-bottom: 2rem;
        flex-grow: 1;
    }

    .notify-btn {
        width: 100%;
        margin-top: auto;
    }
</style>
