---
// src/components/Button.astro

interface Props {
  variant?: 'primary' | 'secondary' | 'cta' | 'play';
  id?: string;
  class?: string;
  ariaLabel?: string;
  href?: string;
}

const { variant = 'primary', id, class: className = '', ariaLabel, href } = Astro.props;

let baseClass = '';
if (variant === 'primary') baseClass = 'btn-primary';
if (variant === 'secondary') baseClass = 'btn-secondary';
if (variant === 'cta') baseClass = 'btn-cta';
if (variant === 'play') baseClass = 'hero-play-btn';
---

{href ? (
  <a href={href} class:list={[baseClass, className]} id={id} aria-label={ariaLabel}>
    <slot />
  </a>
) : (
  <button class:list={[baseClass, className]} id={id} aria-label={ariaLabel}>
    <slot />
  </button>
)}

<style>
/* Primary CTA — Beam Button */
.btn-primary {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    background: var(--primary-dark);
    color: white;
    border: none;
    border-radius: 8px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.4s var(--easing-smooth);
}

.btn-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
    transition: left 0.6s var(--easing-smooth);
    z-index: 1;
}

.btn-primary:hover::before {
    left: 100%;
}

.btn-primary:hover {
    background: #000;
    transform: translateY(-2px);
}

.btn-primary :global(span) {
    position: relative;
    z-index: 2;
}

/* Secondary CTA — Outline */
.btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border-medium);
    border-radius: 8px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.4s var(--easing-smooth);
}

.btn-secondary:hover {
    border-color: var(--primary-dark);
    background: var(--bg-surface);
    transform: translateY(-2px);
}

.btn-secondary :global(.btn-icon) {
    transition: transform 0.4s var(--easing-smooth);
}

.btn-secondary:hover :global(.btn-icon) {
    transform: translateY(2px);
}

/* CTA Button (Footer) */
.btn-cta {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.125rem 2.5rem;
    background: white;
    color: var(--primary-dark);
    border: none;
    border-radius: 8px;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.4s var(--easing-smooth);
}

.btn-cta:hover {
    transform: translateY(-2px);
    background: var(--bg-surface);
}

/* Hero Play Button */
.hero-play-btn {
    position: absolute;
    top: 50%;
    right: 20%;
    transform: translate(50%, -80%);
    z-index: 15;
    width: 80px;
    height: 80px;
    border-radius: var(--radius-full);
    background: var(--accent-warm);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    border: none;
    transition: all 0.5s var(--easing-smooth);
}

.hero-play-btn:hover {
    transform: translate(50%, -80%) scale(1.1);
}

.hero-play-btn :global(svg) {
    width: 24px;
    height: 24px;
    fill: white;
    margin-left: 3px;
}

@media (max-width: 1024px) {
    .hero-play-btn {
        width: 64px;
        height: 64px;
        right: 30%;
        transform: translate(50%, -50%);
    }
    
    .hero-play-btn:hover {
        transform: translate(50%, -50%) scale(1.1);
    }
}

@media (max-width: 640px) {
    .btn-primary,
    .btn-secondary {
        justify-content: center;
        padding: 1rem 2rem;
        width: 100%;
    }
    
    .hero-play-btn {
        width: 56px;
        height: 56px;
    }
}
</style>
